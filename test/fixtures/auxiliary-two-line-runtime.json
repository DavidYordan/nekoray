{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "aux-mixed-101",
      "listen": "127.0.0.1",
      "listen_port": 18120
    },
    {
      "type": "mixed",
      "tag": "aux-mixed-102",
      "listen": "127.0.0.1",
      "listen_port": 18121
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "line-a",
      "server": "127.0.0.1",
      "server_port": 18130
    },
    {
      "type": "http",
      "tag": "line-b",
      "server": "127.0.0.1",
      "server_port": 18131
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "aux-mixed-101"
        ],
        "action": "sniff"
      },
      {
        "inbound": [
          "aux-mixed-102"
        ],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "inbound": [
              "aux-mixed-101"
            ]
          },
          {
            "domain_suffix": [
              "blocked.test"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "inbound": [
          "aux-mixed-101"
        ],
        "outbound": "line-a"
      },
      {
        "inbound": [
          "aux-mixed-102"
        ],
        "outbound": "line-b"
      },
      {
        "inbound": [
          "aux-mixed-101"
        ],
        "domain_suffix": [
          "crossline.test"
        ],
        "outbound": "line-b"
      }
    ],
    "final": "direct"
  }
}
